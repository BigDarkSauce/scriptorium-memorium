{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scriptorium-chain/1",
  "title": "Logical chain of one part",
  "type": "object",
  "required": [
    "chain"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string"
    },
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "definition",
              "axiom",
              "postulate",
              "lemma",
              "theorem",
              "derivation",
              "formula",
              "result",
              "example",
              "remark"
            ]
          },
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "math": {
            "type": "string"
          },
          "derivation": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "expr": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bodies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "term": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                }
              }
            }
          },
          "intuition": {
            "type": "string"
          },
          "misconception": {
            "type": "string"
          },
          "check": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "a": {
                "type": "string"
              }
            }
          },
          "basis": {
            "enum": [
              "source-text",
              "standard",
              "derived",
              "empirical",
              ""
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "authors": {
                  "type": "string"
                },
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "doi": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean",
                  "description": "set by the app after checking OpenAlex"
                }
              }
            }
          },
          "demos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "doi": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "description": "set by the app after checking OpenAlex"
          }
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptorium.invalid/schema/atlas.schema.json",
  "title": "Semantic chapter concept atlas",
  "type": "object",
  "required": [
    "version",
    "question",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": "scriptorium-atlas/1"
    },
    "question": {
      "type": "string",
      "minLength": 5
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 36,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "question",
          "summary",
          "stepIds",
          "subsectionIds",
          "knowledgeKinds",
          "visualIntent",
          "dioramaSet",
          "position",
          "challenges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,55}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "summary": {
            "type": "string"
          },
          "stepIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "subsectionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "knowledgeKinds": {
            "type": "array",
            "items": {
              "enum": [
                "structural",
                "causal",
                "temporal",
                "relational",
                "quantitative",
                "procedural",
                "historical",
                "abstract"
              ]
            }
          },
          "visualIntent": {
            "type": "string"
          },
          "dioramaSet": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "purpose",
                "mustShow",
                "manipulations",
                "medium"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "mustShow": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "manipulations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "medium": {
                  "enum": [
                    "3d",
                    "2d"
                  ]
                },
                "sourceFigureIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  },
                  "description": "Exact source figure IDs explicitly linked to this concept's validated steps; empty when no source visual is used."
                },
                "sourceVisualIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  },
                  "description": "Exact structured chart/SmartArt source visual IDs from a slide mapped to validated steps in this concept."
                }
              }
            }
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "challenges": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "stimulus",
                "question",
                "hint",
                "answer",
                "why",
                "feedback",
                "missingBodyIds"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "structural",
                    "mechanistic",
                    "temporal",
                    "explanatory",
                    "relational",
                    "counterfactual"
                  ]
                },
                "stimulus": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "feedback": {
                  "type": "string"
                },
                "missingBodyIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reasoning": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "description": "Two to five ordered, source-mapped reasoning units, revealed one at a time for newly authored challenges.",
                  "items": {
                    "type": "object",
                    "required": [
                      "title",
                      "text",
                      "sourceStepIds"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 700
                      },
                      "sourceStepIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "dioramaRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stepId",
                "demoIndex",
                "title",
                "purpose"
              ],
              "properties": {
                "stepId": {
                  "type": "string"
                },
                "demoIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "title": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "learnerRequested": {
                  "type": "boolean"
                }
              }
            }
          },
          "sourceRefs": {
            "type": "object",
            "properties": {
              "stepIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subsectionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "figureIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "externalSources": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "pageSpans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "subsectionId",
                    "startPage",
                    "endPage"
                  ],
                  "properties": {
                    "subsectionId": {
                      "type": "string"
                    },
                    "startPage": {
                      "type": "integer"
                    },
                    "endPage": {
                      "type": "integer"
                    }
                  }
                }
              },
              "stepSummaries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stepId",
                    "title",
                    "statement",
                    "answers",
                    "opens",
                    "pages",
                    "figureIds"
                  ],
                  "properties": {
                    "stepId": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "statement": {
                      "type": "string"
                    },
                    "answers": {
                      "type": "string"
                    },
                    "opens": {
                      "type": "string"
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "figureIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "figureRecords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "stepIds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "caption": {
                      "type": "string"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "slide": {
                      "type": "integer"
                    },
                    "mediaPath": {
                      "type": "string"
                    },
                    "stepIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "unresolvedFigureIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "visualIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "visualRecords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "slide",
                    "stepIds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "caption": {
                      "type": "string"
                    },
                    "slide": {
                      "type": "integer"
                    },
                    "mediaPath": {
                      "type": "string"
                    },
                    "sourceSectionId": {
                      "type": "string"
                    },
                    "sourceSectionTitle": {
                      "type": "string"
                    },
                    "stepIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    },
                    "linkBasis": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "visualKind": {
            "enum": [
              "diorama",
              "diagram",
              "concept"
            ]
          },
          "generatedFigure": {
            "type": "object"
          },
          "figureRefs": {
            "type": "array"
          },
          "dioramaBuild": {},
          "explanatoryFigures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stepId",
                "title",
                "purpose",
                "figure"
              ],
              "properties": {
                "stepId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "figure": {
                  "type": "object"
                },
                "sourceVisualId": {
                  "type": "string",
                  "description": "ID of the exact extracted chart or SmartArt source visual reconstructed in this figure."
                },
                "sourceSlide": {
                  "type": "integer",
                  "minimum": 1
                },
                "sourceKind": {
                  "enum": [
                    "chart",
                    "smartart",
                    "visual"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "label"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "prerequisite",
              "part-of",
              "causes",
              "enables",
              "constrains",
              "transforms-into",
              "regulates",
              "contrasts-with",
              "evidence-for",
              "temporal-before",
              "spatial-within",
              "application-of"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unassignedNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceIndex": {
      "type": "object",
      "properties": {
        "sourceType": {
          "enum": [
            "pdf",
            "pptx"
          ]
        },
        "sourceUnit": {
          "enum": [
            "page",
            "slide"
          ]
        },
        "webResearch": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "searched": {
              "type": "integer",
              "minimum": 0
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "start": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "sourceVisualIndex": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "slide",
              "stepIds"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "slide": {
                "type": "integer"
              },
              "mediaPath": {
                "type": "string"
              },
              "sourceSectionId": {
                "type": "string"
              },
              "sourceSectionTitle": {
                "type": "string"
              },
              "stepIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "linkBasis": {
                "type": "string"
              },
              "data": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object"
    },
    "attempts": {
      "type": "object"
    },
    "selectedNodeId": {
      "type": "string"
    },
    "memoryPlaces": {
      "type": "array",
      "description": "Optional learner-authored memory cues anchored to stable bookcase-local locations. The route is not a source claim or a mastery score.",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "caseId",
          "row",
          "slot",
          "association"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "shelfName": {
            "type": "string",
            "maxLength": 100
          },
          "rowLabel": {
            "type": "integer",
            "minimum": 1
          },
          "association": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "review": {
            "type": "object",
            "properties": {
              "response": {
                "type": "string",
                "maxLength": 1200
              },
              "confidence": {
                "enum": [
                  "",
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "committed": {
                "type": "boolean"
              },
              "attemptedAt": {
                "type": "string",
                "format": "date-time"
              },
              "revealed": {
                "type": "boolean"
              },
              "revealedAt": {
                "type": "string",
                "format": "date-time"
              },
              "history": {
                "type": "array",
                "description": "Earlier recall attempts retained when the learner starts a fresh attempt at the same locus.",
                "items": {
                  "type": "object",
                  "required": [
                    "response",
                    "confidence"
                  ],
                  "properties": {
                    "response": {
                      "type": "string",
                      "maxLength": 1200
                    },
                    "confidence": {
                      "enum": [
                        "",
                        "Low",
                        "Medium",
                        "High"
                      ]
                    },
                    "attemptedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "revealedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "rating": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "again",
                        "recalled",
                        null
                      ]
                    },
                    "gradedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                },
                "maxItems": 12
              },
              "rating": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "again",
                  "recalled",
                  null
                ]
              },
              "gradedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptorium.invalid/schema/figure.schema.json",
  "title": "Figure spec (an explanatory drawing the reader renders)",
  "description": "A small JSON drawing a chain carries for a text-heavy paragraph (explain[k].figure, statementFigure) or a teaching box (intuitionFigure, misconceptionFigure, check.figure). The model returns data, never pictures or SVG code; js/room/diagrams.js (renderFigure) draws it with typeset labels; js/room/figspec.js (validateFigure) checks it. Every figure has kind and caption; 'animate' makes a short loop (shown as a still with a play button under prefers-reduced-motion). Data from the PDF gives 'ref'; data from outside gives 'extra' with sources. The domain primitives (progressive_construction … algorithm_sandbox) are interactive figures of the explanatory compiler (js/dio/domains.js validatePrimitive, drawn by js/dio/prims/*.js; docs/research/explanatory-compiler.md).",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "flow",
        "plot",
        "distribution",
        "bars",
        "hist",
        "scatter",
        "boxplot",
        "numberline",
        "tree",
        "venn",
        "timeline",
        "sketch",
        "codetrace",
        "table",
        "contrast",
        "pdf",
        "progressive_construction",
        "state_machine",
        "transform2d",
        "distribution_lab",
        "causal_loop",
        "competing_explanations",
        "flow_network",
        "argument_map",
        "data_narrative",
        "algorithm_sandbox"
      ]
    },
    "caption": {
      "type": "string",
      "maxLength": 220,
      "description": "what to see, ≤ 25 words (required except for pdf)"
    },
    "title": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "extra": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "animate": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "required": [
            "param",
            "from",
            "to"
          ],
          "properties": {
            "param": {
              "type": "string"
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "period": {
              "type": "number"
            }
          }
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "short": {
                "type": "string"
              },
              "value": {},
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        ]
      },
      "description": "flow / state_machine / causal_loop: {id,label,…}; argument_map: {id,type,text,short?}"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "dir": {
      "enum": [
        "LR",
        "TB"
      ]
    },
    "x": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "y": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "xlabel": {
      "type": "string"
    },
    "ylabel": {
      "type": "string"
    },
    "logx": {
      "type": "boolean"
    },
    "curves": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "expr"
        ],
        "properties": {
          "expr": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "dash": {
            "type": "boolean"
          }
        }
      }
    },
    "points": {
      "type": "array"
    },
    "vlines": {
      "type": "array"
    },
    "hlines": {
      "type": "array"
    },
    "shade": {
      "type": "object",
      "properties": {
        "expr": {
          "type": "string"
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "dist": {
      "enum": [
        "normal",
        "t",
        "chisq",
        "binomial",
        "poisson",
        "uniform",
        "exponential"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array"
        },
        "rows": {
          "type": "array"
        }
      }
    },
    "highlight": {
      "type": "array"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "bins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "count"
        ]
      }
    },
    "fit": {
      "oneOf": [
        {
          "const": "ols"
        },
        {
          "type": "object",
          "required": [
            "slope",
            "intercept"
          ]
        }
      ]
    },
    "residuals": {
      "type": "boolean"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ]
      }
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "step": {
      "type": "number"
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ]
      }
    },
    "root": {
      "type": "object",
      "required": [
        "label"
      ]
    },
    "sets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3
    },
    "regions": {
      "type": "object"
    },
    "universe": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ]
      }
    },
    "w": {
      "type": "number"
    },
    "h": {
      "type": "number"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shape"
        ],
        "properties": {
          "shape": {
            "enum": [
              "rect",
              "circle",
              "ellipse",
              "line",
              "arrow",
              "text",
              "path"
            ]
          }
        }
      }
    },
    "lang": {
      "type": "string"
    },
    "lines": {
      "type": "array"
    },
    "output": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "array"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "table rows (arrays of cells), or an algorithm_sandbox map as strings ('#' wall, 'F' costly, 'S' start, 'G' goal)"
    },
    "wrong": {
      "type": "object",
      "required": [
        "text"
      ]
    },
    "right": {
      "type": "object",
      "required": [
        "text"
      ]
    },
    "id": {
      "type": "string",
      "description": "pdf: the PDF figure id (fig-3-2, fig-p12-1)"
    },
    "parts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          }
        ]
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adds",
          "why"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "adds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "test": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "array"
          },
          {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "rel": {
                "enum": [
                  "supports",
                  "attacks",
                  "answers",
                  "revises",
                  "addresses"
                ]
              }
            }
          }
        ]
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "array"
          },
          {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "ticks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "packets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "value": {}
              }
            }
          },
          "set": {
            "type": "object"
          },
          "state": {
            "type": "string"
          }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "matrix"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "matrix": {
            "type": "array"
          }
        }
      }
    },
    "vector": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "eigen": {
      "type": "boolean"
    },
    "mu": {
      "type": "number"
    },
    "sigma": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "muRange": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "sigmaRange": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "nodes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "question": {
      "type": "string"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "label",
          "claim"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "predicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "fits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fits": {
            "type": "object"
          },
          "note": {
            "type": "string"
          },
          "observed": {
            "type": "boolean"
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "enum": [
              "customer",
              "firm",
              "supplier",
              "intermediary",
              "competitor",
              "platform",
              "regulator",
              "partner"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "money",
              "goods",
              "info"
            ]
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "units": {
      "type": "object",
      "required": [
        "price",
        "items"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "show": {},
          "highlight": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "annotate": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "text"
              ],
              "properties": {
                "at": {
                  "type": "number"
                },
                "series": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "type": "string"
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "year": {},
        "note": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "mode": {
      "enum": [
        "story",
        "slides"
      ]
    },
    "chart": {
      "enum": [
        "bars",
        "line",
        "dots"
      ]
    },
    "grid": {
      "type": "object",
      "properties": {
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "goal": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "forest": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "algorithm": {
      "enum": [
        "bfs",
        "dijkstra",
        "greedy",
        "astar"
      ]
    },
    "algorithms": {
      "type": "array",
      "items": {
        "enum": [
          "bfs",
          "dijkstra",
          "greedy",
          "astar"
        ]
      }
    },
    "cost": {
      "type": "number"
    },
    "start": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pdf"
          }
        },
        "required": [
          "kind"
        ]
      },
      "else": {
        "anyOf": [
          {
            "required": [
              "caption"
            ],
            "properties": {
              "caption": {
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "minLength": 1
              }
            }
          }
        ]
      },
      "description": "caption is required except for kind pdf (validateFigure accepts the title in its place)"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "flow"
          }
        }
      },
      "then": {
        "required": [
          "nodes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plot"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "curves"
            ]
          },
          {
            "required": [
              "points"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "distribution"
          }
        }
      },
      "then": {
        "required": [
          "dist"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "scatter"
          }
        }
      },
      "then": {
        "required": [
          "points"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "numberline"
          }
        }
      },
      "then": {
        "required": [
          "min",
          "max"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tree"
          }
        }
      },
      "then": {
        "required": [
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "codetrace"
          }
        }
      },
      "then": {
        "required": [
          "lines"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "contrast"
          }
        }
      },
      "then": {
        "required": [
          "wrong",
          "right"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pdf"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "progressive_construction"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "parts",
          "stages"
        ]
      }
    },
    {
      "if": {
        "properties": {

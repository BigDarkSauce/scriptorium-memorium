{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptorium.invalid/schema/scene.schema.json",
  "title": "Universal diorama scene",
  "type": "object",
  "required": [
    "type",
    "bodies"
  ],
  "properties": {
    "type": {
      "const": "scene"
    },
    "title": {
      "type": "string"
    },
    "technique": {
      "enum": [
        "card",
        "sweep",
        "topdown"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "studio",
            "lab",
            "landscape",
            "cosmos",
            "micro",
            "abstract",
            "ocean",
            "night",
            "desk"
          ]
        },
        "time": {
          "type": "number"
        },
        "glassCase": {
          "type": "boolean"
        },
        "base": {
          "type": "boolean"
        }
      }
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "shape"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "enum": [
              "actor",
              "decor"
            ]
          },
          "describe": {
            "type": "string"
          },
          "shape": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string"
              }
            }
          },
          "material": {
            "type": "object"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "scale": {},
          "parent": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "tour": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "min",
          "max",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "rebuild": {
            "type": "boolean"
          }
        }
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "type"
        ]
      }
    },
    "code": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "description": "the one question this lesson settles"
          },
          "text": {
            "type": "string"
          },
          "set": {
            "type": "object"
          },
          "focus": {
            "type": "string"
          },
          "run": {
            "type": "number"
          },
          "until": {
            "type": "string",
            "description": "event:<substring of an api.event text>"
          },
          "explain": {
            "type": "string"
          },
          "opens": {
            "type": "string",
            "description": "the question it raises next = the next lesson's question"
          },
          "shot": {
            "enum": [
              "wide",
              "push",
              "close",
              "pov",
              "medium"
            ]
          },
          "pov": {
            "type": "string"
          },
          "cameraMode": {
            "enum": [
              "global",
              "object",
              "component",
              "mechanism",
              "frame"
            ],
            "description": "the explanatory level of the beat: global (wide) | object (medium) | component (push) | mechanism (static, holds) | frame (POV)"
          },
          "level": {
            "type": "string",
            "description": "the level of the scene's \"levels\" the beat is on"
          },
          "explainBack": {
            "type": "string",
            "description": "a question the learner answers in their own words"
          },
          "explode": {
            "type": "object",
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "axis": {
                "anyOf": [
                  {
                    "enum": [
                      "auto",
                      "x",
                      "y",
                      "z"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "distance": {
                "type": "number"
              },
              "labels": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "const": "numbered"
                  }
                ]
              },
              "hold": {
                "type": "number"
              },
              "reassemble": {
                "type": "boolean"
              },
              "anchor": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            }
          },
          "assemble": {
            "type": "object",
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "minItems": 1
              },
              "from": {
                "enum": [
                  "above",
                  "outside"
                ]
              },
              "stagger": {
                "type": "number"
              }
            }
          },
          "inspect": {
            "anyOf": [
              {
                "type": "array"
              },
              {
                "type": "object",
                "required": [
                  "parts"
                ],
                "properties": {
                  "parts": {
                    "type": "array",
                    "minItems": 1
                  },
                  "hold": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "section": {
            "type": "object",
            "properties": {
              "on": {
                "anyOf": [
                  {
                    "enum": [
                      "all",
                      "*"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "axis": {
                "anyOf": [
                  {
                    "enum": [
                      "x",
                      "y",
                      "z"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "at": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "keep": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sweep": {
                "type": "number"
              },
              "depth": {
                "type": "number"
              },
              "caption": {
                "type": "string"
              }
            }
          },
          "compare": {
            "type": "object",
            "required": [
              "b"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "side",
                  "split"
                ]
              },
              "a": {
                "type": "object"
              },
              "b": {
                "type": "object",
                "required": [
                  "set"
                ],
                "properties": {
                  "set": {
                    "type": "object"
                  },
                  "label": {
                    "type": "string"
                  },
                  "read": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "progression": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 2
              },
              {
                "type": "object",
                "required": [
                  "stages"
                ],
                "properties": {
                  "stages": {
                    "type": "array",
                    "minItems": 2
                  }
                }
              }
            ]
          },
          "scaleTo": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "r"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "r": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "color": {
                      "type": "string"
                    }
                  }
                }
              },
              "unit": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "3–6 lessons forming a question thread: lesson k+1 \"question\" = lesson k \"opens\""
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "doi": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "description": "set by the app after checking OpenAlex"
          }
        }
      }
    },
    "overrides": {
      "type": "object"
    },
    "additions": {
      "type": "array"
    },
    "hidden": {
      "type": "array"
    },
    "ranges": {
      "type": "object"
    },
    "extra": {
      "type": "array",
      "description": "material added from outside the PDF; shown with an 'Added from outside the PDF' badge",
      "items": {
        "type": "object",
        "required": [
          "what"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "authors": {
                "type": "string"
              },
              "year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "doi": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "verified": {
                "type": "boolean",
                "description": "set by the app after checking OpenAlex"
              }
            }
          }
        }
      }
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "levels": {
      "type": "array",
      "description": "the levels of the multiscale scene graph: names or {name, at:actor}; drives the level indicator"
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "required": [
        "stage",
        "technique",
        "cameraMode",
        "purpose",
        "answers"
      ],
      "properties": {
        "stage": {
          "enum": [
            "curiosity",
            "orientation",
            "decomposition",
            "inspection",
            "mechanism",
            "intuition",
            "reconstruction",
            "understanding"
          ],
          "description": "Jared Owen's explanatory sequence, used as a planning algorithm"
        },
        "technique": {
          "enum": [
            "establish",
            "explode",
            "assemble",
            "inspect",
            "section",
            "peel",
            "isolate",
            "chain",
            "zoom",
            "scaleTo",
            "compare",
            "progression",
            "track",
            "pov",
            "analogy",
            "answer"
          ],
          "description": "an operation of the visual grammar (js/dio/grammar.js), by name"
        },
        "cameraMode": {
          "enum": [
            "global",
            "object",
            "component",
            "mechanism",
            "frame"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 4
        },
        "answers": {
          "type": "string",
          "minLength": 4
        },
        "opens": {
          "type": "string"
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lesson": {
          "type": "integer",
          "minimum": 0
        },
        "motion": {
          "type": "object",
          "properties": {
            "explanatory": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "background": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "which motion explains, and which only makes the scene alive"
        },
        "sub": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat"
          },
          "description": "the sequence again, inside this beat (recursive)"
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "the didactic plan written before the demo (docs/PEDAGOGY.md); checked by tools/verify-chain.mjs",
      "required": [
        "question",
        "knowledgeKind",
        "sequence",
        "comprehensionCheck"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 5
        },
        "knowledgeKind": {
          "anyOf": [
            {
              "enum": [
                "structural",
                "internal",
                "causal",
                "scale",
                "history",
                "pathology",
                "movement",
                "perspective"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "structural",
                  "internal",
                  "causal",
                  "scale",
                  "history",
                  "pathology",
                  "movement",
                  "perspective"
                ]
              }
            }
          ]
        },
        "levels": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/beat"
          }
        },
        "analogy": {
          "type": "object",
          "required": [
            "familiar",
            "limit"
          ],
          "properties": {
            "familiar": {
              "type": "string"
            },
            "maps": {
              "type": "string"
            },
            "limit": {
              "type": "string"
            }
          }
        },
        "comprehensionCheck": {
          "type": "object",
          "required": [
            "explainBack",
            "misconceptionToAvoid"
          ],
          "properties": {
            "explainBack": {
              "type": "string",
              "minLength": 5
            },
            "misconceptionToAvoid": {
              "type": "string",
              "minLength": 3
            },
            "answer": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

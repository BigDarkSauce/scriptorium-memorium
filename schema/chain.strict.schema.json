{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptorium.invalid/schema/chain.strict.schema.json",
  "title": "Logical chain of one part (strict profile)",
  "description": "The strict profile of chain.schema.json: what a finished chain must satisfy before it is pasted into the app. On top of the base schema it requires the part's question and coverage, and on every step its subsection id, the question it answers and the one it opens; ids follow the shared id rules (docs/PROTOCOL.md); every demo has a purpose; every 3D demo (a built-in model or an authored scene) has 3–6 lessons with question and opens; every outside addition has a source. tools/verify-chain.mjs applies it, together with the checks a schema cannot express (thread, coverage, figures, event texts).",
  "allOf": [
    {
      "$ref": "chain.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "title",
    "question",
    "chain",
    "coverage"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2
    },
    "question": {
      "type": "string",
      "minLength": 3
    },
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subsection",
          "steps"
        ],
        "properties": {
          "subsection": {
            "$ref": "#/$defs/sectionId"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/stepId"
            }
          }
        }
      }
    },
    "figuresSkipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/figureId"
          },
          "why": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "stepId": {
      "type": "string",
      "pattern": "^S[1-9][0-9]*$",
      "description": "S1, S2, … in chain order"
    },
    "sectionId": {
      "type": "string",
      "pattern": "^(?:(?:[0-9]{1,3}|[A-Z])(?:\\.[0-9]{1,3}){0,4}|p[0-9]{1,4}\\.0|p[0-9]{1,4}-[0-9]{1,3}|(?:(?:[0-9]{1,3}|[A-Z])(?:\\.[0-9]{1,3}){0,3}|p[0-9]{1,4})-w[0-9]{1,3})'*$",
      "description": "1.2.3 · 1.0 · p12.0 · p12-1 · 3-w2 · p5-w1 (a trailing ' marks a repeated id)"
    },
    "figureId": {
      "type": "string",
      "pattern": "^(?:fig|tab)-(?:p[0-9]{1,4}-[0-9]{1,3}|[a-z0-9]+(?:-[a-z0-9]+)*)(?:-b)*$",
      "description": "fig-3-2 · fig-3-2a · tab-1-1 · fig-p12-1 · tab-p12-1"
    },
    "source": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "doi"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2
        },
        "doi": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "authors": {
          "type": "string"
        }
      }
    },
    "extra": {
      "type": "object",
      "required": [
        "what",
        "source"
      ],
      "properties": {
        "what": {
          "type": "string",
          "minLength": 3
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "title",
        "question",
        "text",
        "opens"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 3
        },
        "opens": {
          "type": "string",
          "minLength": 3
        },
        "until": {
          "type": "string",
          "pattern": "^event:.+"
        },
        "run": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shot": {
          "enum": [
            "wide",
            "push",
            "close",
            "pov",
            "medium"
          ]
        },
        "cameraMode": {
          "enum": [
            "global",
            "object",
            "component",
            "mechanism",
            "frame"
          ],
          "description": "the explanatory level of the beat: global (wide) | object (medium) | component (push) | mechanism (static, holds) | frame (POV)"
        }
      }
    },
    "demo": {
      "type": "object",
      "required": [
        "type",
        "purpose"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 2
        },
        "purpose": {
          "type": "string",
          "minLength": 3
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra"
          }
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "pendulum",
                  "doublependulum",
                  "spring",
                  "projectile",
                  "orbit",
                  "collision",
                  "incline",
                  "lever",
                  "wave",
                  "gas",
                  "reaction",
                  "efield",
                  "circuit",
                  "lens",
                  "surface",
                  "weatherglass"
                ]
              }
            }
          },
          "then": {
            "required": [
              "lessons"
            ],
            "properties": {
              "lessons": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "$ref": "#/$defs/lesson"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type",
              "bodies"
            ],
            "properties": {
              "type": {
                "const": "scene"
              }
            }
          },
          "then": {
            "required": [
              "lessons"
            ],
            "properties": {
              "lessons": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "$ref": "#/$defs/lesson"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "scene"
              }
            },
            "not": {
              "required": [
                "bodies"
              ]
            }
          },
          "then": {
            "required": [
              "request",
              "title"
            ],
            "properties": {
              "request": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "section",
        "kind",
        "title",
        "answers",
        "opens"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "section": {
          "$ref": "#/$defs/sectionId"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "answers": {
          "type": "string",
          "minLength": 3
        },
        "opens": {
          "type": "string",
          "minLength": 3
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figureId"
          }
        },
        "from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepId"
          }
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "demos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/demo"
          }
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "stage",
        "technique",
        "cameraMode",
        "purpose",
        "answers"
      ],
      "properties": {
        "stage": {
          "enum": [
            "curiosity",
            "orientation",
            "decomposition",
            "inspection",
            "mechanism",
            "intuition",
            "reconstruction",
            "understanding"
          ],
          "description": "Jared Owen's explanatory sequence, used as a planning algorithm"
        },
        "technique": {
          "enum": [
            "establish",
            "explode",
            "assemble",
            "inspect",
            "section",
            "peel",
            "isolate",
            "chain",
            "zoom",
            "scaleTo",
            "compare",
            "progression",
            "track",
            "pov",
            "analogy",
            "answer"
          ],
          "description": "an operation of the visual grammar (js/dio/grammar.js), by name"
        },
        "cameraMode": {
          "enum": [
            "global",
            "object",
            "component",
            "mechanism",
            "frame"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 4
        },
        "answers": {
          "type": "string",
          "minLength": 4
        },
        "opens": {
          "type": "string"
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lesson": {
          "type": "integer",
          "minimum": 0
        },
        "motion": {
          "type": "object",
          "properties": {
            "explanatory": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "background": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "which motion explains, and which only makes the scene alive"
        },
        "sub": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat"
          },
          "description": "the sequence again, inside this beat (recursive)"
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "the didactic plan written before the demo (docs/PEDAGOGY.md); checked by tools/verify-chain.mjs",
      "required": [
        "question",
        "knowledgeKind",
        "sequence",
        "comprehensionCheck"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 5
        },
        "knowledgeKind": {
          "anyOf": [
            {
              "enum": [
                "structural",
                "internal",
                "causal",
                "scale",
                "history",
                "pathology",
                "movement",
                "perspective"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "structural",
                  "internal",
                  "causal",
                  "scale",
                  "history",
                  "pathology",
                  "movement",
                  "perspective"
                ]
              }
            }
          ]
        },
        "levels": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/beat"
          }
        },
        "analogy": {
          "type": "object",
          "required": [
            "familiar",
            "limit"
          ],
          "properties": {
            "familiar": {
              "type": "string"
            },
            "maps": {
              "type": "string"
            },
            "limit": {
              "type": "string"
            }
          }
        },
        "comprehensionCheck": {
          "type": "object",
          "required": [
            "explainBack",
            "misconceptionToAvoid"
          ],
          "properties": {
            "explainBack": {
              "type": "string",
              "minLength": 5
            },
            "misconceptionToAvoid": {
              "type": "string",
              "minLength": 3
            },
            "answer": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
